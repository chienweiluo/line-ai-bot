LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000

BOT_NAME=AI 助手
HISTORY_LIMIT=10
HISTORY_TTL_MINUTES=60
IMAGE_TTL_MINUTES=10
MESSAGE_TTL_DAYS=7
EXPENSE_TTL_DAYS=6

# 用 Haiku 做便宜的自動偵測(花費抽取 / 收據 OCR)
HAIKU_MODEL=claude-haiku-4-5-20251001
DEFAULT_CURRENCY=THB

# 雲端部署時改成持久磁碟路徑,例:/app/data/bot.db
DB_PATH=./data/bot.db
